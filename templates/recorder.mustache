{{!
    @template tiny_screenrecorder/recorder

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="tiny-screenrecorder" data-region="screenrecorder">
    <div class="alert alert-info mb-3" role="status" data-region="status">
        {{#str}}status:ready, tiny_screenrecorder{{/str}}
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3"
         data-region="capture-options">
        <div>
            <div class="btn-group" role="group" aria-label="{{#str}}buttontitle, tiny_screenrecorder{{/str}}">
                <button type="button" class="btn btn-outline-secondary active"
                        data-source="screen" aria-pressed="true">
                    {{#str}}source:screen, tiny_screenrecorder{{/str}}
                </button>
                {{#allowppt}}
                <button type="button" class="btn btn-outline-secondary"
                        data-source="presentation" aria-pressed="false">
                    {{#str}}source:presentation, tiny_screenrecorder{{/str}}
                </button>
                {{/allowppt}}
            </div>
            {{#allowppt}}
            <div class="small text-muted mt-2 d-none" data-region="presentation-help">
                {{#str}}source:presentation_help, tiny_screenrecorder{{/str}}
            </div>
            {{/allowppt}}
        </div>

        <div class="d-flex flex-column gap-2">
            {{#allowwebcam}}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="tiny-screenrecorder-webcam"
                       data-option="webcam">
                <label class="form-check-label" for="tiny-screenrecorder-webcam">
                    {{#str}}option:webcam, tiny_screenrecorder{{/str}}
                </label>
            </div>
            {{/allowwebcam}}
            {{#allowmicrophone}}
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="tiny-screenrecorder-microphone"
                       data-option="microphone" checked>
                <label class="form-check-label" for="tiny-screenrecorder-microphone">
                    {{#str}}option:microphone, tiny_screenrecorder{{/str}}
                </label>
            </div>
            {{/allowmicrophone}}
        </div>
    </div>

    <div class="tiny-screenrecorder-stage mb-3">
        <video data-region="preview" playsinline></video>
        <canvas data-region="canvas" class="d-none"></canvas>
        <video data-region="screen-source" class="d-none" playsinline muted></video>
        <video data-region="webcam-source" class="d-none" playsinline muted></video>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" class="btn btn-primary" data-action="start">
            {{#str}}action:start, tiny_screenrecorder{{/str}}
        </button>
        <button type="button" class="btn btn-danger d-none" data-action="stop">
            {{#str}}action:stop, tiny_screenrecorder{{/str}}
        </button>
        <button type="button" class="btn btn-secondary d-none" data-action="rerecord">
            {{#str}}action:rerecord, tiny_screenrecorder{{/str}}
        </button>
        <button type="button" class="btn btn-outline-secondary d-none" data-action="download">
            {{#str}}action:download, tiny_screenrecorder{{/str}}
        </button>
        <button type="button" class="btn btn-primary d-none" data-action="upload">
            {{#str}}action:attach, tiny_screenrecorder{{/str}}
        </button>
        <span class="ms-auto font-monospace" data-region="timer">0:00 / {{maxduration}}</span>
    </div>

    <div class="progress mt-3 d-none" data-region="progress" role="progressbar"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <div class="progress-bar" data-region="progressbar" style="width: 0%"></div>
    </div>
</div>
